      <aliases enabled='yes' />
      <column caption='YTD NORMAL' datatype='real' name='[Calculation_303148558965456898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))}THEN [Sales] END' />
      </column>
      <column caption='%DIFFERENCE' datatype='real' name='[Calculation_303148558974316548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_303148558965456898])-SUM([YTD NORMAL (copy)_303148558974062595]))/SUM([YTD NORMAL (copy)_303148558974062595])' />
      </column>
      <column caption='MARGIN SALES' datatype='string' name='[Calculation_303148558976491525]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_303148558965456898])-SUM([YTD NORMAL (copy)_303148558974062595])&lt;0 THEN &apos;LESS THEN PY&apos;&#13;&#10; ELSEIF     SUM([Calculation_303148558965456898])-SUM([YTD NORMAL (copy)_303148558974062595])&gt;0 THEN &apos;GREATER THEN PY&apos;&#13;&#10; ELSEIF ISNULL(SUM([YTD NORMAL (copy)_303148558974062595])) THEN &apos;NO PY SALES&apos;&#13;&#10;END' />
      </column>
      <column caption='ARROW' datatype='string' name='[Calculation_303148558978199558]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_303148558974316548]&gt;0 THEN &apos;▲&apos;&#13;&#10;ELSEIF  [Calculation_303148558974316548]&lt;0 THEN&apos;▼&apos;&#13;&#10;END' />
      </column>
      <column caption='NO SALES' datatype='string' name='[Calculation_303148558980780039]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_303148558976491525] = &apos;NO PY SALES&apos; THEN &apos;NO PY SALES&apos;END' />
      </column>
      <column caption='YTD' datatype='real' name='[Calculation_412079374670741504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :SUM(IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))} THEN [Sales] END)}' />
      </column>
      <column caption='YTY' datatype='real' name='[Calculation_412079374675853314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_412079374670741504]-[YTD (copy)_412079374675525633]) / [YTD (copy)_412079374675525633]' />
      </column>
      <column caption='YTY ARROW' datatype='string' name='[Calculation_412079374679576579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_412079374675853314]&gt;0 THEN&apos;▲&apos; ELSEIF   [Calculation_412079374675853314]&lt;0 THEN &apos;▼&apos;&#13;&#10;END' />
